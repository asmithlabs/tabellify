{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git merge *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)"
    ],
    "ask": [
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(npm install *)",
      "Bash(npm publish *)",
      "Bash(gh release *)"
    ],
    "deny": [
      "Read(~/Zotero/**)",
      "Edit(~/Zotero/**)",
      "Read(~/Library/Application Support/Zotero/**)",
      "Edit(~/Library/Application Support/Zotero/**)",
      "Read(~/Zotero tabellify-dev/**)",
      "Edit(~/Zotero tabellify-dev/**)",
      "Bash(rm -rf *)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git push *+*)",
      "Bash(git push *--delete*)",
      "Bash(git push *-d *)",
      "Bash(git push *--mirror*)",
      "Bash(git push * :*)",
      "Bash(gh release delete *)",
      "Bash(gh release edit *)",
      "Bash(gh release upload *)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
