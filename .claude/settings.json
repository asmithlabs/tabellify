{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git tag *)",
      "Bash(git reset --hard *)",
      "Bash(npm install *)",
      "Bash(npm publish *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)"
    ],
    "deny": [
      "Read(~/Zotero/**)",
      "Edit(~/Zotero/**)",
      "Read(~/Library/Application Support/Zotero/**)",
      "Edit(~/Library/Application Support/Zotero/**)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
